LIBRARY d3d12
EXPORTS
    D3D12CreateDevice=ProxyCreateDevice @101
    D3D12GetDebugInterface=ProxyGetDebug @102
    D3D12CreateRootSignatureDeserializer=ProxyDeserialize @106
    D3D12CreateVersionedRootSignatureDeserializer=ProxyDeserializeVersioned @107
    D3D12EnableExperimentalFeatures=ProxyExperimental @109
    D3D12GetInterface=ProxyGetInterface @110
    D3D12SerializeRootSignature=ProxySerialize @115
    D3D12SerializeVersionedRootSignature=ProxySerializeVersioned @116
